<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Login - Ruki Restaurant</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <div class="auth-wrapper">
    <div class="glass-panel auth-card">
      <div class="auth-header">
        <h2>Sign In</h2>
        <p>Access persistent orders & history</p>
      </div>

      <!-- Frontend & Backend Validation Banners -->
      <div id="frontend-error" class="alert alert-danger" style="display: none;"></div>

      <% if (errors && errors.system) { %>
        <div class="alert alert-danger"><%= errors.system %></div>
      <% } %>

      <form action="/login" method="POST" id="login-form" novalidate>
        <div class="form-group">
          <label for="email">Email Address</label>
          <input 
            type="email" 
            name="email" 
            id="email" 
            class="form-control" 
            placeholder="name@example.com"
            value="<%= values.email || '' %>"
            required
          >
          <% if (errors && errors.email) { %>
            <div style="color: var(--accent-red); font-size: 0.85rem; margin-top: 6px;"><%= errors.email %></div>
          <% } %>
        </div>

        <div class="form-group">
          <label for="password">Password</label>
          <input 
            type="password" 
            name="password" 
            id="password" 
            class="form-control" 
            placeholder="••••••••"
            required
          >
          <% if (errors && errors.password) { %>
            <div style="color: var(--accent-red); font-size: 0.85rem; margin-top: 6px;"><%= errors.password %></div>
          <% } %>
        </div>

        <button type="submit" class="btn-primary" style="width: 100%; margin-top: 10px;">
          <span>Sign In to Account</span>
        </button>
      </form>

      <div class="auth-footer">
        Don't have an account? <a href="/signup">Sign Up</a>
      </div>
      
      <div class="auth-footer" style="margin-top: 10px;">
        <a href="/" style="color: var(--text-secondary); font-size: 0.85rem;">← Back to Guest Chat</a>
      </div>
    </div>
  </div>

  <script>
    const form = document.getElementById('login-form');
    const emailInput = document.getElementById('email');
    const passwordInput = document.getElementById('password');
    const errorBox = document.getElementById('frontend-error');

    form.addEventListener('submit', function(e) {
      errorBox.style.display = 'none';
      errorBox.textContent = '';
      
      const email = emailInput.value.trim();
      const password = passwordInput.value;

      // Validate email format
      const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
      if (!email) {
        e.preventDefault();
        showError('Email address is required.');
        return;
      }
      if (!emailRegex.test(email)) {
        e.preventDefault();
        showError('Please enter a valid email address.');
        return;
      }

      // Validate password
      if (!password) {
        e.preventDefault();
        showError('Password is required.');
        return;
      }
    });

    function showError(msg) {
      errorBox.textContent = msg;
      errorBox.style.display = 'block';
      window.scrollTo(0, 0);
    }
  </script>
</body>
</html>
